          <pose>0.22 0 0.12 0 0 0</pose>
          <topic>/camera</topic>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <camera>
            <horizontal_fov>1.0471975512</horizontal_fov>
            <optical_frame_id>camera_optical_frame</optical_frame_id>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>8.0</far>
